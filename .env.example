# ── Anthropic ──────────────────────────────────────────────────────────────────
# Direct API key (required unless using AWS Bedrock)
ANTHROPIC_API_KEY=sk-ant-...

# Model ID — defaults to claude-sonnet-5 if not set
ANTHROPIC_MODEL=claude-sonnet-5

# ── AWS Bedrock (optional alternative to direct API) ───────────────────────────
# Set to true to route Claude calls through AWS Bedrock instead of the Anthropic API
CLAUDE_CODE_USE_BEDROCK=false
AWS_REGION=us-east-1

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite is the supported default. Other SQLAlchemy databases require their DBAPI driver.
# DATABASE_URL=sqlite:///./resume_tailor.db
